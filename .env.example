# Postgres (must match docker-compose.dev.yml POSTGRES_PASSWORD)
# Host port 5433 (not 5432) to avoid clashing with other local projects.
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/transescort_db

# API
NODE_ENV=development
PORT=3010
HOST=0.0.0.0
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:3011
ALLOWED_ORIGINS=http://localhost:3011

# S3-compatible storage (MinIO in dev — console at http://localhost:9001)
# Bucket name must be lowercase (S3 naming rules) and match what MinIO actually has.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=transescort
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_PUBLIC_URL=http://localhost:9000/transescort

# SMTP (Mailhog in dev — inbox at http://localhost:8026)
# 127.0.0.1, not localhost — on Docker Desktop "localhost" can resolve to ::1 first, and if the
# IPv6 port mapping doesn't route, the SMTP connection just hangs instead of failing.
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_FROM=LuxEscortia <noreply@transescort.local>
CONTACT_FORM_TO_EMAIL=contact@transescort.local

# Telegram bot (optional) — powers "Привязать Telegram" in /cabinet/settings.
# Create one via @BotFather in Telegram, paste the token below. Leave empty to disable linking.
TELEGRAM_BOT_TOKEN=

# Web
NEXT_PUBLIC_API_URL=http://localhost:3010
